# =============================================
# HYUK - Variables de entorno (producción)
# Copia a .env.local en desarrollo y carga las
# variables en Vercel (Producción / Preview).
# =============================================

# Supabase (OBLIGATORIO)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Google Gemini (OBLIGATORIO para el módulo de IA)
GEMINI_API_KEY=tu-gemini-api-key

# Dominio raíz del SaaS (OBLIGATORIO para subdominios de tiendas). Ej: hyuk.app
NEXT_PUBLIC_ROOT_DOMAIN=hyuk.app

# URL pública de la app (para SEO/sitemaps/OG). Ej: https://hyuk.app
NEXT_PUBLIC_APP_URL=https://hyuk.app

# Sentry (OPCIONAL - si está vacío, Sentry se desactiva)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel (auto inyectado - NO configurar manualmente)
# VERCEL_URL
# NEXT_PUBLIC_VERCEL_URL
